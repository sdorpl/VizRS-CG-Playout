{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VizRS CG Playout",
  "mainBinaryName": "vizrs-live-desktop",
  "version": "26.11.35",
  "identifier": "pl.vizrs.Live",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "VizRS CG Playout – panel kanału (powered by ErsatzTV)",
    "longDescription": "Natywna aplikacja sterowania kanałem: klient panelu VizRS CG Playout działającego na serwerze w stosie z ErsatzTV legacy; token panelu zostaje w programie.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "copyright": "VizRS",
    "publisher": "VizRS",
    "homepage": "https://github.com/sdorpl/VizRS-Live"
  }
}
